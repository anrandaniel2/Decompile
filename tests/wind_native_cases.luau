-- Exercise the real state layer with native WindUI render functions, not an old UI facade.
local lib, saves, themes = createCheesyUIState(WindUI)
local window = lib:GetNativeWindow()
local tab = lib:RegisterTab(window:Tab({ Title = "Home", Icon = "house" }), "Home")
local section = tab:Section({ Title = "Features", Box = true, Opened = true })
tab:Select(); lib.ActiveTab = tab
assert(rawWindow.selected == tab and lib.ActiveTab == tab)
local other = lib:RegisterTab(window:Tab({ Title = "Other" }), "Other")
other.UIElements.Main.MouseButton1Click:Fire(); assert(lib.ActiveTab == other)
other.UIElements.Main.Visible = false; assert(not other.UIElements.Main.Visible)

local UiLibrary = lib
-- NATIVE_RENDERERS: populated from the standalone script by the test runner.
local function mount(group, kind, id, spec, owner)
    return lib:Mount(group, kind, id, spec, nativeRenderers[kind], owner)
end

local first = mount(section, "Toggle", "FloorOne", { Title = "One" })
lib:TrackElement(section, section:Divider())
assert(section.CheesyElements[1] == first and first.Holder == first.Element.ElementFrame)
assert(section.CheesyElements[2].Holder ~= nil)
section.CheesyElements[1].Holder.Visible = false
assert(not first.Element.ElementFrame.Visible)

local disabled = mount(section, "Toggle", "Unavailable", { Title = "Unavailable", Value = false, Disabled = true, DisabledTooltip = "Not supported" })
assert(disabled.Disabled and disabled.Element.Locked and disabled.Element.config.LockedTitle == "Not supported")
disabled:SetValue(true)
assert(disabled.Value and disabled.Element.Value and disabled.Element.Locked)
local changedCount, observed = 0, nil
local toggle = mount(section, "Toggle", "Feature", { Title = "Feature", Value = false,
    Callback = function(v) changedCount += 1; observed = v end })
toggle:OnChanged(function(v) observed = v end)
local key = mount(section, "KeyPicker", "FeatureKey", { Title = "Feature", Value = "F", Mode = "Toggle", SyncToggleState = true }, toggle)
toggle:SetValue(true); assert(toggle.Value and observed and changedCount == 1 and key.Toggled)
inputs.InputBegan:Fire({ KeyCode = keys.F }, false)
assert(not toggle.Value and not key.Toggled and changedCount == 2)
inputs.InputBegan:Fire({ KeyCode = keys.F }, false)
assert(toggle.Value and key:GetState())
key.ModePicker:Select("Always"); flush(); assert(key.Mode == "Always" and key:GetState())
key.ModePicker:Select("Toggle"); flush(); assert(key.Mode == "Toggle")
local hold = mount(section, "Toggle", "Hold", { Title = "Hold", Value = false })
local holdKey = mount(section, "KeyPicker", "HoldKey", { Title = "Hold", Value = "H", Mode = "Hold", SyncToggleState = true }, hold)
inputs.down.H = true; inputs.InputBegan:Fire({ KeyCode = keys.H }, false)
assert(hold.Value and holdKey:GetState())
inputs.down.H = false; inputs.InputEnded:Fire({ KeyCode = keys.H })
assert(not hold.Value and not holdKey:GetState())
local mouse = mount(section, "Toggle", "MouseFeature", { Title = "Mouse" })
local mouseKey = mount(section, "KeyPicker", "MouseKey", { Title = "Mouse", Value = "MouseLeftButton", Mode = "Hold", SyncToggleState = true }, mouse)
inputs.down.Mouse1 = true; inputs.InputBegan:Fire({ KeyCode = keys.Unknown, UserInputType = "Mouse1" }, false)
assert(mouse.Value and mouseKey:GetState())
inputs.down.Mouse1 = false; inputs.InputEnded:Fire({ KeyCode = keys.Unknown, UserInputType = "Mouse1" })
assert(not mouse.Value and not mouseKey:GetState())
local menu = mount(section, "KeyPicker", "MenuKeybind", { Title = "Menu", Value = "RightShift", NoUI = true })
lib.ToggleKeybind = menu; menu:Update(); assert(rawWindow.toggleKey == keys.RightShift)
menu.Element.UIElements.Keybind.Frame.Frame.TextLabel.Text = "K"
assert(menu.Value == "K" and rawWindow.toggleKey == keys.K)
toggle:SetDisabled(true); toggle:SetValue(false); assert(not toggle.Value and not toggle.Element.Value and changedCount == 3)
toggle:SetDisabled(false); toggle:SetValue(true); assert(changedCount == 4)
toggle.Element.config.Callback(false); assert(not toggle.Value and changedCount == 5)
toggle:SetValue(true)

local slider = mount(section, "Slider", "Speed", { Title = "Speed", Min = 0, Max = 20, Value = 5, Precision = 1 })
local sliderCount = 0; slider:OnChanged(function() sliderCount += 1 end)
slider:SetValue(10); assert(slider.Value == 10 and sliderCount == 1 and slider.Element.config.Step == 0.1)
slider.Element.config.Callback("12.5"); assert(slider.Value == 12.5 and sliderCount == 2)
slider:SetValue(10)
local drop = mount(section, "Dropdown", "Items", { Title = "Items", Values = {"A", "B"}, Multi = true })
local dropCount = 0; drop:OnChanged(function() dropCount += 1 end)
flush(); assert(dropCount == 0)
drop:SetValue({ A = true }); flush(); assert(drop.Value.A and not drop.Value.B and dropCount == 1)
drop.Element.Value = {"A", "B"}; drop.Element:Refresh({"A", "B"}); flush()
assert(drop.Value.A and drop.Value.B and dropCount == 2)
drop:SetValues({"A", "B", "C"}); flush(); assert(dropCount == 2)
drop:SetValues({"B", "C"}); flush(); assert(not drop.Value.A and drop.Value.B and dropCount == 3)
drop:SetValue({ A = true, B = true }); flush()
local playerDrop = mount(section, "Dropdown", "Target", { Title = "Player", SpecialType = "Player", ExcludeLocalPlayer = true, SearchBarEnabled = true })
assert(#playerDrop.Values == 1 and playerDrop.Values[1] == "Alice" and playerDrop.Element.config.SearchBarEnabled)
playerDrop:SetValue("Alice")
local bob = { Name = "Bob" }; table.insert(players.list, bob); players.PlayerAdded:Fire(bob); flush()
assert(#playerDrop.Values == 2)
players.PlayerRemoving:Fire(players.list[2]); flush()
assert(playerDrop.Value == nil and #playerDrop.Values == 1 and playerDrop.Values[1] == "Bob")
local pick = mount(section, "ColorPicker", "Tint", { Title = "Tint", Value = Color3.fromHex("ffffff") })
pick:SetValueRGB(Color3.fromHex("123456"), 0.2); assert(pick.Value.hex == "123456" and pick.Transparency == 0.2)
local field = mount(section, "Input", "Text", { Title = "Text", Value = "start" })
field:SetValue("new"); assert(field.Value == "new")
local buttonCalls = 0
local button = mount(section, "Button", nil, { Title = "Do", Callback = function() buttonCalls += 1 end })
mount(section, "KeyPicker", "ButtonKey", { Title = "Do", Value = "P", Mode = "Press" }, button)
inputs.InputBegan:Fire({ KeyCode = keys.P }, false); assert(buttonCalls == 1)
button.Element.config.Callback(); assert(buttonCalls == 2)

local addon = tab:Section({ Title = "Native addon" })
local addonToggle = mount(addon, "Toggle", "AddonToggle", { Title = "Addon" })
mount(addon, "KeyPicker", "AddonKey", { Title = "Addon", Value = "Z", SyncToggleState = true }, addonToggle)
lib:ReleaseSection(addon)
assert(lib.Toggles.AddonToggle == nil and lib.Options.AddonKey == nil and addon.Destroyed)
inputs.InputBegan:Fire({ KeyCode = keys.Z }, false); assert(not addonToggle.Value)

saves:SetFolder("cheesy/Configs"); saves:SetIgnoreIndexes({ "MenuKeybind" })
assert(saves:Save("test") and isfile("cheesy/Configs/test.json"))
assert(not saves:Save("../escape"))
assert(saves:SaveAutoloadConfig("test") and readfile("cheesy/Configs/autoload.txt") == "test")
toggle:SetValue(false); slider:SetValue(1); drop:SetValue({}); field:SetValue("changed")
assert(saves:Load("test")); flush()
assert(toggle.Value and slider.Value == 10 and drop.Value.A and drop.Value.B and field.Value == "new")
assert(pick.Value.hex == "123456" and key.Value == "F")
local style = mount(section, "Dropdown", "NotifyStyle", { Title = "Style", Values = {"WindUI", "Achievement"}, Value = 1 })
writefile("cheesy/Configs/old.json", http:JSONEncode({ objects = {{ idx = "NotifyStyle", type = "Dropdown", value = "Obsidian" }} }))
assert(saves:Load("old")); flush(); assert(style.Value == "WindUI")
saves:BuildConfigSection(tab); flush()
local configSection = tab.sections[#tab.sections]
assert(configSection.config.Title == "Configs" and #configSection.elements == 8)
configSection.elements[1].config.Callback("native_config")
configSection.elements[3].config.Callback(); flush(); assert(isfile("cheesy/Configs/native_config.json"))
configSection.elements[5].config.Callback(); flush(); assert(not isfile("cheesy/Configs/native_config.json"))
themes:ApplyToGroupbox(section); themes:LoadDefault()
local nativeTheme = section.elements[#section.elements]
nativeTheme.config.Callback("Light")
assert(WindUI.theme == "Light" and readfile("cheesy/Data/wind_theme.txt") == "Light")
lib:SetWindowIconVisible(false); assert(rawWindow.iconSize == 0)
lib:SetWindowIconVisible(true); assert(rawWindow.iconSize == 22)
lib:Notify({Title = "Hello", Description = "Body", Time = 3})
assert(WindUI.lastNotification.Title == "Hello" and WindUI.lastNotification.Content == "Body" and WindUI.lastNotification.Duration == 3)
assert(saves:Delete("test") and not isfile("cheesy/Configs/test.json") and not isfile("cheesy/Configs/autoload.txt"))
local cleaned = 0; lib:OnUnload(function() cleaned += 1 end)
lib:Unload(); lib:Unload(); assert(cleaned == 1 and rawWindow.Destroyed)
print("Native WindUI state tests passed")
